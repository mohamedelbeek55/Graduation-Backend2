# ======================================================
# LexaGuide Backend - Environment Variables Template
# ======================================================
# 1) Copy this file to .env
# 2) Replace <placeholders> with your real values
# ======================================================

# Server
PORT=3000
APP_ENV=development
PUBLIC_BASE_URL=http://127.0.0.1:3000
PUBLIC_FRONTEND_URL=http://localhost:5500

# MongoDB (use ONE of the following)
# ---- Local MongoDB ----
MONGODB_URI=mongodb://localhost:27017/Lexa

# ---- MongoDB Atlas (Cloud / Live Demo) ----
# MONGODB_URI=mongodb+srv://<your-user>:<your-password>@<cluster-url>.mongodb.net/LexaGuide?retryWrites=true&w=majority

# JWT Secrets (use strong random strings in production!)
JWT_ACCESS_SECRET=replace-with-a-strong-random-access-secret-key
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_SECRET=replace-with-a-strong-random-refresh-secret-key
JWT_REFRESH_EXPIRES=30d

# Cloudinary (for avatar / document uploads)
# Get keys from https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=<your-cloud-name>
CLOUDINARY_API_KEY=<your-api-key>
CLOUDINARY_API_SECRET=<your-api-secret>

# Default Admin (seeded via scripts/seed-admin.js)
SEED_ADMIN_EMAIL=admin@lexaguide.com
SEED_ADMIN_PASSWORD=Admin12345
SEED_ADMIN_NAME=Lexa Admin

# CORS - comma-separated allowed origins (no trailing slashes)
FRONTEND_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000,http://localhost:3001,https://your-frontend.vercel.app
